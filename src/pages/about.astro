---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About';
const description = 'Frontier engineer, builder, and traveler — building systems, exploring ideas, and consuming unreasonable amounts of LLM tokens.';
const permalink = `${Astro.site.href}about`;
---

<BaseLayout title={title} description={description} permalink={permalink} current="about">
  <div class="container">
    <h1>About</h1>
    <figure class="about-image">
      <img src="/assets/tokenhungry.webp" alt="Illustration of a developer eating a bowl of AI token cereal" width="330">
    </figure>
    <p>Frontier engineer. Builder. Traveler. Curious about history, science, and what’s next. Building systems, exploring ideas, and consuming unreasonable amounts of LLM tokens.</p>
  </div>
</BaseLayout>

<style>
  .about-image {
    float: right;
    margin: -3em -7em 2em 2em;
    max-width: 300px;
  }

  .about-image img {
    border-radius: 8px;
    margin-bottom: 1.5em;
  }

  @media (max-width: 1020px) {
    .about-image {
      float: none;
      margin: 0 auto 2em;
    }
  }
</style>
