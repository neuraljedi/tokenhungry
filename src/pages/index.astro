---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'TokenHungry | Tech Blog';
const description = 'Systems, AI, and everything I\'m building and learning along the way.';
const permalink = Astro.site.href;
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="home-container">
    <div class="home-copy">
      <h1>Welcome to my tech blog</h1>
      <p class="tagline">Systems, AI, and everything I'm building and learning along the way.</p>
      <a class="cta" href="/blog">Read the blog →</a>
    </div>

    <div class="hero-image-container">
      <img class="hero-image" alt="A collection of Raspberry Pi boards wired together on a breadboard setup" src="/assets/raspberry.webp" width="2048" height="768">
    </div>
  </div>
</BaseLayout>

<style>
  .home-container {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    margin: 2em 0;
    min-height: 400px;
  }

  .home-copy {
    text-align: center;
    padding: 0 1em 1.5em;
  }

  .home-copy h1 {
    font-weight: 700;
    margin-bottom: 0.5em;
    line-height: 1.3;
  }

  .home-copy p {
    font-size: 1.4em;
  }

  .tagline {
    color: var(--text-secondary);
    max-width: 42ch;
    margin: 0 auto 1.5em;
    line-height: 1.5;
  }

  .cta {
    display: inline-block;
    font-family: var(--font-family-sans);
    font-weight: 600;
    text-decoration: none;
    color: var(--primary-color);
    border: 1.5px solid var(--primary-color);
    padding: 0.65em 1.5em;
    border-radius: 8px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .cta:hover {
    background-color: var(--primary-color);
    color: #fff;
  }

  .hero-image-container {
    text-align: center;
  }

  .hero-image {
    width: 100%;
    max-width: 1200px;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    margin: 0 auto;
  }

  @media (max-width: 1200px) {
    .home-copy p {
      font-size: 1.2em;
    }
  }
</style>
